{
    "name": "ebpf-bridge",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    // Loading and attaching XDP programs and creating network namespaces for
    // the e2e tests needs a privileged container.
    "privileged": true,
    "workspaceFolder": "/workspaces/ebpf-bridge",
    "postCreateCommand": "git config --global --add safe.directory /workspaces/ebpf-bridge && go mod download",
    "customizations": {
        "vscode": {
            "settings": {
                "go.buildTags": "e2e",
                "go.lintTool": "golangci-lint"
            },
            "extensions": [
                "golang.go",
                "ms-vscode.cpptools",
                "zxh404.vscode-proto3"
            ]
        }
    }
}
